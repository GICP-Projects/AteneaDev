# RELEASE CONFIGURATION
ATENEA_VERSION=v0.8.0

# DJANGO CONFIGURATION
DJANGO_SETTINGS_MODULE=
DJANGO_LOG_LEVEL=INFO
DJANGO_SECRET_KEY=
DJANGO_SERVER_TIMEZONE=Europe/Madrid
# Comma-separated hosts/IPs (besides localhost) allowed to serve the API, e.g. api.example.org,10.0.0.5
DJANGO_EXTRA_ALLOWED_HOSTS=
# Comma-separated front-end origins (besides localhost:3001) allowed by CORS, e.g. http://10.0.0.5:3001
DJANGO_EXTRA_CORS_ORIGINS=
GOOGLE_OAUTH2_CLIENT=
GOOGLE_OAUTH2_SECRET=
JWT_SIGNATURE_SECRET=
ACCESS_TOKEN_EXPIRE_SECONDS=86400
REFRESH_TOKEN_EXPIRE_SECONDS=99999999

DEPLOYMENT_UNIQUE_SUFFIX= # To avoid collision between different deployments sharing Elastic/Qdrant

# ELASTIC CONFIGURATION
ELASTICSEARCH_HOST=
ELASTICSEARCH_APIKEY_ID=
ELASTICSEARCH_APIKEY_API_KEY=
# PostgreSQL message IDs materialized per online indexing batch.
ELASTICSEARCH_INDEX_SOURCE_BATCH_SIZE=2500
# Maximum documents/actions sent in one Elasticsearch _bulk request.
ELASTICSEARCH_BULK_CHUNK_SIZE=2500

# CLICKHOUSE ENTITY ANALYTICS (HTTP port; dev host: 127.0.0.1:28123)
CLICKHOUSE_IMAGE=clickhouse/clickhouse-server:26.8
CLICKHOUSE_HOST=atenea-clickhouse
CLICKHOUSE_PORT=8123
# Use a different database per deployment, e.g. atenea_dev_gic / atenea_prod_gic.
CLICKHOUSE_DATABASE=
CLICKHOUSE_USER=atenea
CLICKHOUSE_PASSWORD=
CLICKHOUSE_SECURE=false
CLICKHOUSE_VERIFY=true
CLICKHOUSE_CONNECT_TIMEOUT=10
CLICKHOUSE_REQUEST_TIMEOUT=180
CLICKHOUSE_BATCH_SIZE=50000
# General starting limits PER QUERY; size for host resources and concurrent requests.
CLICKHOUSE_MAX_THREADS=8
# Maximum tracked query memory: 8 GiB (bytes), not reserved in advance.
CLICKHOUSE_MAX_MEMORY_BYTES=8589934592
# Spill GROUP BY state to disk after 2 GiB (bytes); leave memory for the merge phase.
CLICKHOUSE_EXTERNAL_GROUP_BY_BYTES=2147483648
CLICKHOUSE_DEDUPLICATION_WINDOW=10000

# POSTGRESQL CONFIGURATION
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
# Container/server limits; conservative defaults for a modest host.
POSTGRES_SHM_SIZE=1gb
POSTGRES_MAX_WORKER_PROCESSES=8
POSTGRES_MAX_PARALLEL_WORKERS=4
PGADMIN_DEFAULT_EMAIL=admin@gicp.es
PGADMIN_DEFAULT_PASSWORD=admin

# REDIS CONFIGURATION
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

# S3-COMPATIBLE MEDIA STORAGE CONFIGURATION
MEDIA_S3_ENDPOINT_URL=http://localhost:9000
MEDIA_S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
MEDIA_S3_REGION=us-east-1
MEDIA_S3_BUCKET=atenea-telegram-media
MEDIA_S3_ACCESS_KEY=minioadmin
MEDIA_S3_SECRET_KEY=minioadmin
MEDIA_S3_ADDRESSING_STYLE=path
MEDIA_S3_USE_SSL=false
MEDIA_S3_VERIFY_SSL=false
MEDIA_S3_PRESIGNED_TTL_SECONDS=900
MEDIA_S3_MAX_FILE_SIZE_BYTES=52428800
MEDIA_S3_CREATE_BUCKET=true
MEDIA_DOWNLOAD_PROGRESS_TTL_SECONDS=86400
MEDIA_DOWNLOADABLE_DELETE_CONFIRM_THRESHOLD=25
MEDIA_EXTERNAL_URL_WHITELIST_EXTRA=

# MICROSERVICES CONFIGURATION
NER_SERVICE_API_KEY=
NER_SERVICE_HOST=atenea_services_net
NER_SERVICE_PORT=80
NER_SERVICE_MAX_DATA_BY_REQUEST=2000
# These are conservative defaults.
NER_BATCH_SIZE=10000
NER_EXTRACT_MAX_INFLIGHT=1
NER_BACKFILL_MAX_INFLIGHT=1
NER_EXTRACT_MAX_RETRIES=3
NER_EXTRACT_SOFT_TIME_LIMIT=900
NER_EXTRACT_TIME_LIMIT=1020
NER_EXTRACT_LEASE_SECONDS=1200
NER_STORE_MAX_RETRIES=10
NER_STORE_SOFT_TIME_LIMIT=900
NER_STORE_TIME_LIMIT=1020
NER_STORE_LEASE_SECONDS=1200
NER_HTTP_MAX_CONCURRENCY=2
NER_HTTP_TIMEOUT_SECONDS=300
NER_METADATA_TIMEOUT_SECONDS=20
NER_RECONCILE_INTERVAL_SECONDS=60

# Celery worker process counts.  deploy_dev.sh and the production Compose file
# use these values for their queue-specific --concurrency flags.
QUEUE_DEFAULT_CONCURRENCY=4
QUEUE_INDEX_CONCURRENCY=1
QUEUE_TELEGRAM_SCAN_CONCURRENCY=1
QUEUE_TELEGRAM_SCAN_COMMENTS_CONCURRENCY=1
QUEUE_TELEGRAM_POPULATE_CONCURRENCY=1
QUEUE_NER_LIVE_CONCURRENCY=1
QUEUE_NER_BACKFILL_CONCURRENCY=1
QUEUE_NER_STORE_CONCURRENCY=1
QUEUE_EMBED_CONCURRENCY=1
QUEUE_SENTIMENT_CONCURRENCY=1

# Telegram scan, populate and access jobs.
TELEGRAM_SCAN_ROOMS_PER_BATCH=300
# Parent MessageItem IDs per comments batch (separate from room scans).
TELEGRAM_SCAN_COMMENTS_MESSAGES_PER_BATCH=300
TELEGRAM_SCAN_MAX_INFLIGHT=1
TELEGRAM_SCAN_MAX_RETRIES=3
TELEGRAM_SCAN_SOFT_TIME_LIMIT=7200
TELEGRAM_SCAN_TIME_LIMIT=7800
TELEGRAM_SCAN_LEASE_SECONDS=8400
TELEGRAM_POPULATE_SEEDS_PER_BATCH=200
TELEGRAM_POPULATE_MAX_INFLIGHT=1
TELEGRAM_POPULATE_SOFT_TIME_LIMIT=3600
TELEGRAM_POPULATE_TIME_LIMIT=3900
TELEGRAM_POPULATE_LEASE_SECONDS=4200
TELEGRAM_ACCESS_ROOMS_PER_BATCH=200
TELEGRAM_ACCESS_MAX_INFLIGHT=1
TELEGRAM_ACCESS_MAX_RETRIES=3
TELEGRAM_ACCESS_SOFT_TIME_LIMIT=3600
TELEGRAM_ACCESS_TIME_LIMIT=3900
TELEGRAM_ACCESS_LEASE_SECONDS=4200

# Index jobs.
INDEX_MANUAL_BATCH_SIZE=100000
INDEX_MAX_INFLIGHT=1
INDEX_MAX_RETRIES=3
INDEX_SOFT_TIME_LIMIT=3600
INDEX_TIME_LIMIT=3900
INDEX_LEASE_SECONDS=4200

# Embeddings and sentiment jobs.
EMBEDDINGS_SOURCE_READ_SIZE=100000
EMBEDDINGS_BATCH_SIZE=10000
SENTIMENT_SOURCE_READ_SIZE=500000
SENTIMENT_BATCH_SIZE=10000
METADATA_MAX_INFLIGHT=1
METADATA_MAX_RETRIES=3
METADATA_SOFT_TIME_LIMIT=3600
METADATA_TIME_LIMIT=3900
METADATA_LEASE_SECONDS=4200

# Shared durable-task safety settings.
PROCESSING_BATCH_LEASE_SECONDS=1200
PROCESSING_VISIBILITY_TIMEOUT_SECONDS=9000
OPENAI_EMBEDDINGS_BASE_URL=http://localhost:28333/v1
OPENAI_EMBEDDINGS_API_KEY=
OPENAI_EMBEDDINGS_MODEL=Qwen/Qwen3-Embedding-4B
OPENAI_EMBEDDINGS_MAX_DATA_BY_REQUEST=500
OPENAI_EMBEDDINGS_MAX_PARALLEL_REQUESTS=10
OPENAI_EMBEDDINGS_TIMEOUT=60
# Optional. Leave empty to let the provider return its default embedding size.
# Recommended for vLLM/Ollama unless you know the backend supports `dimensions`.
OPENAI_EMBEDDINGS_DIMENSIONS=
EMBEDDINGS_PENDING_TIMEOUT_SECONDS=900
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_TIMEOUT=60
# Search-time tuning (optional):
# - hnsw_ef: larger -> better recall, slower search.
# - exact: true -> exact kNN (slow, useful for quality evaluation only).
QDRANT_SEARCH_HNSW_EF=
QDRANT_SEARCH_EXACT=
# Collection HNSW defaults for NEW collections created by Atenea (optional):
# Existing collections are NOT modified by these values.
QDRANT_HNSW_M=
QDRANT_HNSW_EF_CONSTRUCT=
QDRANT_HNSW_FULL_SCAN_THRESHOLD=
QDRANT_UPSERT_BATCH_SIZE=400
QDRANT_UPSERT_MAX_RETRIES=2
QDRANT_UPSERT_RETRY_DELAY_SECONDS=2
QDRANT_COLLECTION_MESSAGE_SEARCH=msg_search_embeddings
QDRANT_COLLECTION_CATEGORIZATION=categorization_embeddings
SENTIMENT_SERVICE_API_KEY=
SENTIMENT_SERVICE_HOST=atenea_services_net
SENTIMENT_SERVICE_PORT=80
SENTIMENT_SERVICE_MAX_DATA_BY_REQUEST=5000
